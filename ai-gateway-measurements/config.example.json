    "timeout_seconds": 30
  },
  "email": {
    "smtp_host": "replace-with-smtp-host",
    "smtp_port": 587,
    "username": "replace-with-mailbox-or-smtp-user",
    "password": "replace-with-smtp-password-or-app-password",
    "from_addr": "replace-with-sender-email",
    "use_tls": true,
