# Java 项目 Dockerfile —— **简单单文件版本**
#
# 适用场景：
#   - 单 service / 不会经常换运行时镜像版本
#   - 不想搞 .gitlab-ci.yml 里的 DOCKER_BUILD_ARGS 配置
#
# 局限：
#   - 运行时镜像版本写死在 FROM 行，升级要改这里
#   - 多 service mono-repo 不适合（PMS 那种场景用 Dockerfile.java-parameterized.example）
#
# 用 base-image-builder 提供的 jre 镜像作 FROM（已内置 appuser 非 root，不要再切回 root）。
# 可用 tag 见 references/base-image-catalog.md。

FROM cld93-ld-tcr-premium-sh-001.tencentcloudcr.com/devops/jre11.0.16:<TAG>

# 国内源默认开（清华），外网构建时覆盖为空字符串
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
      && sed -i "s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# 若同时在 CI 里跑了 build-app（BUILD_TOOL=mvn/gradle），构建产物会作为 artifacts 传递到 build-container
# 这里 COPY 构建产物即可
COPY target/*.jar app.jar

EXPOSE 8080

# 基础镜像已 USER appuser，不要再切回 root

CMD ["java", "-jar", "app.jar"]
