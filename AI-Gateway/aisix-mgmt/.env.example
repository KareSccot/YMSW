# ============================================================
# 环境变量模板
# ============================================================
# 复制此文件为 .env 并填写实际值:
#   cp .env.example .env
#
# 注意: .env 文件包含敏感信息，请勿提交到版本控制。
#       已在 .gitignore 中排除 .env 文件。
# ============================================================

# ── JWT 认证 ──────────────────────────────────────────────
# 生产环境务必修改为强随机字符串（推荐: openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── 客户端凭证（格式: id1:secret1,id2:secret2）────────────
# 生产环境务必使用强密码
CLIENT_CREDENTIALS=admin:admin123

# ── AI Gateway 后端 ───────────────────────────────────────
AI_GATEWAY_BASE_URL=https://aisix-poc.apiseven.com
AI_GATEWAY_TOKEN=your_api_token_here
AI_GATEWAY_ENV_ID=e7fd60b3-bbd8-4058-9b25-4b6d84eaa084
AI_GATEWAY_ORG_SLUG=wuxibiologics
AI_GATEWAY_DEFAULT_MODELS=deepseek

# ── 运行模式（生产环境务必设为 false）──────────────────
# python app.py 默认以 DEBUG=true 运行（dev 模式）
# Docker 部署时 docker-compose.yml 已强制设为 false
DEBUG=false
DEV_MODE=false

# ── 日志 ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 服务端口 ─────────────────────────────────────────────
PORT=5000
HTTPS_PORT=8443

# ── SSL / HTTPS（可选，启用后 5000 提供 HTTP，8443 提供 HTTPS）──
# 将 cert.pem 和 key.pem 放入 ./certs/ 目录
# K8s 部署时，Service 将 HTTPS 流量路由到 Pod 8443 端口
SSL_ENABLED=false
SSL_CERT_FILE=/app/certs/cert.pem
SSL_KEY_FILE=/app/certs/key.pem

# ── Gunicorn Workers ─────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ── 资源限制 ─────────────────────────────────────────────
CPU_LIMIT=1.0
MEMORY_LIMIT=512M