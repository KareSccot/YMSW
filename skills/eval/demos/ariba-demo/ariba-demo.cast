[1204.2047209739685,"o","\u001b[38;2;255;255;255m\r●\u001b[m\u001b[1C三个文件已生成。现在产出最后一件——\u001b[1mGitLab CI/CD Variables 清单\u001b[22m。\r\n\u001b[K\u001b[22;3H按\u001b[1Cvariables-output 模块逻辑合成：固定必填段（Docker\u001b[1CRegistry\u001b[1C4\u001b[1C个）+\u001b[1CUAT\u001b[1C部分。本项目是\u001b[1CArgoCD\u001b[1C路径、容器只跑\u001b[23;3HHTTP，所以 SSH 部署变量、SSL\u001b[1C证书变量都按需/不适用。\u001b[24;6H\u001b[K\u001b[25;3H---\r\n\u001b[K\r\n  \u001b[1m该项目需要在 GitLab → Settings → CI/CD → Variables 配置的变量\u001b[22m\r\n\u001b[K\u001b[29;3H配置位置：GitLab 项目 → \u001b[1mSettings → CI/CD → Variables\u001b[22m\u001b[K\u001b[66C\r\n\n  \u001b[1m1.\u001b[22m \u001b[1mDocker\u001b[22m \u001b[1mRegistry（4\u001b[22m \u001b[1m个，必填）——\u001b[22m \u001b[1m构建\u001b[22m \u001b[1mpush\u001b[22m \u001b[1m+\u001b[22m \u001b[1m部署\u001b[22m \u001b[1mpull\u001b[22m \u001b[1m都用\u001b[22m\u001b[K\u001b[57C\r\n\u001b[120C\r\n  ┌────────────────────┬──────────────────────────────────────────────────────────"]
[1204.2048773765564,"o","───┬────────┬───────────┬──────────┐  \r\n  │       变量名       │                            用途                             │ Masked │ Protected │   来源   │  \r\n  ├────────────────────┼─────────────────────────────────────────────────────────────┼────────┼───────────┼──────────┤  \r\n  │ \u001b[38;2;177;185;249mDOCKER_REGISTRY    \u001b[m│ TCR 域名（如                                                │ ☐      │ ☐         │ 运维     │  \r\n  │                    │ \u001b[38;2;177;185;249mcld93-ld-tcr-premium-sh-001.tencentcloudcr.com\u001b[m）            │        │           │          │  \r\n  ├────────────────────┼────────"]
[1204.2049584388733,"o","─────────────────────────────────────────────────────┼────────┼───────────┼──────────┤  \r\n  │ \u001b[38;2;177;185;249mREGISTRY_USER      \u001b[m│ Registry 登录用户名                                         │ ☐      │ ☐         │ 运维     │  \r\n  ├────────────────────┼─────────────────────────────────────────────────────────────┼────────┼───────────┼──────────┤  \r\n  │ \u001b[38;2;177;185;249mREGISTRY_PASSWORD  \u001b[m│ Registry 登录密码                                           │ ✅     │ ☐         │ 运维     │  \r\n  ├────────────────────┼───"]
[1204.2050335407257,"o","──────────────────────────────────────────────────────────┼────────┼───────────┼──────────┤  \r\n  │ \u001b[38;2;177;185;249mSERVICE_REPOSITORY \u001b[m│ 镜像命名空间（如 \u001b[38;2;177;185;249mmno/myteam\u001b[m），不覆盖默认 \u001b[38;2;177;185;249mchange_me \u001b[m会失败  │ ☐      │ ☐         │ 团队约定 │  \r\n  └────────────────────┴─────────────────────────────────────────────────────────────┴────────┴───────────┴──────────┘  \r\n\u001b[120C\r\n  \u001b[2m▎\u001b[22m \u001b[3m这\u001b[23m \u001b[3m4\u001b[23m \u001b[3m个通常在\u001b[23m \u001b[3mGitLab\u001b[23m \u001b[1m\u001b[3mGroup\u001b[22m\u001b[23m \u001b[1m\u001b[3m层面已配好\u001b[22m；项目\u001b[23m \u001b[3mUI\u001b[23m \u001b[3m"]
[1204.2051174640656,"o","看不到说明是继承的，不用重复配。如果\u001b[23m \u001b[3mCI\u001b[23m \u001b[3m报\u001b[23m \u001b[38;2;177;185;249m\u001b[3mchange_me \u001b[m\u001b[3m相关错误，说明\u001b[23m  \r\n  \u001b[2m▎\u001b[22m \u001b[38;2;177;185;249m\u001b[3mSERVICE_REPOSITORY \u001b[m\u001b[3m没配好，补上即可。\u001b[23m\u001b[K\u001b[79C\r\n\u001b[120C\r\n  \u001b[1m2.\u001b[22m \u001b[1mUAT\u001b[22m \u001b[1mSSH\u001b[22m \u001b[1m部署（本项目暂不需要）\u001b[22m\u001b[K\u001b[85C\r\n\u001b[120C\r\n  ┌─────────────────────┬───────────┬─────────────────────────────────────┐\u001b[45C\r\n  │       变量名        │   状态    │                说明                 │\u001b[45C\r\n  ├─────────────────────┼───────────┼─────────────────────────────────────┤\u001b[45C\r\n  │ \u001b[38;2;177;185;249mUAT_SSH_TARGET      \u001b[m│ ❌ 不适用 │ 本项目走 ArgoCD/K8s，不用"]
[1204.2051801681519,"o"," SSH 到 VM │\u001b[K\u001b[45C\r\n  ├─────────────────────┼───────────┼─────────────────────────────────────┤\u001b[45C\r\n  │ \u001b[38;2;177;185;249mUAT_SSH_USER        \u001b[m│ ❌ 不适用 │ 同上                                │\u001b[K\u001b[45C\r\n  ├─────────────────────┼───────────┼─────────────────────────────────────┤\u001b[45C\r\n  │ \u001b[38;2;177;185;249mUAT_SSH_PORT        \u001b[m│ ❌ 不适用 │ 同上                                │\u001b[K\u001b[45C\r\n  ├─────────────────────┼───────────┼─────────────────────────────────────┤\u001b[45C\r\n  │ \u001b[38;2;177;185;249mUAT_SSH_PRIVATE_KEY \u001b[m│ ❌ 不适用 │ 同"]
[1204.2052319049835,"o","上                                │\u001b[K\u001b[45C\r\n  ├─────────────────────┼───────────┼─────────────────────────────────────┤\u001b[45C\r\n  │ \u001b[38;2;177;185;249mUAT_DEPLOY_PATH     \u001b[m│ ❌ 不适用 │ 同上                                │\u001b[K\u001b[45C\r\n  └─────────────────────┴───────────┴─────────────────────────────────────┘\u001b[45C\r\n\u001b[120C\r\n  \u001b[2m▎\u001b[22m \u001b[3m这些是\u001b[23m \u001b[3mVM\u001b[23m \u001b[3mdocker-compose\u001b[23m \u001b[3m部署才用的。ArgoCD\u001b[23m \u001b[3m路径下\u001b[23m \u001b[38;2;177;185;249m\u001b[3m.gitlab-ci.yml \u001b[m\u001b[3m已禁用\u001b[23m \u001b[38;2;177;185;249m\u001b[3mdeploy-container-uat\u001b[m\u001b[3m，不需要\u001b[23m \u001b[3mSSH\u001b[23m \u001b[3m变量。\u001b[23m    \r\n\u001b[120C\r\n  \u001b[1m3.\u001b[22m \u001b[1mPROD\u001b[22m \u001b[1m部署（本项目暂不需要）\u001b[22m\u001b[K\u001b[88C\r\n\u001b[120C\r\n  本"]
[1204.205304145813,"o","项目是 \u001b[1mUAT\u001b[22m \u001b[1monly\u001b[22m，PROD 未接入。\u001b[38;2;177;185;249mPROD_* \u001b[m变量（\u001b[38;2;177;185;249mPROD_SSH_TARGET \u001b[m/ \u001b[38;2;177;185;249mPROD_SSH_USER \u001b[m/ \u001b[38;2;177;185;249mPROD_SSH_PORT \u001b[m/ \u001b[38;2;177;185;249mPROD_SSH_PRIVATE_KEY \u001b[m/ \r\n  \u001b[38;2;177;185;249mPROD_DEPLOY_PATH \u001b[m/ \u001b[38;2;177;185;249mAPPSECURITY_APPROVERS\u001b[m）\u001b[1m本项目暂不需要\u001b[22m，后续接入 PROD 时再配（届时所有 \u001b[38;2;177;185;249mPROD_* \u001b[m变量建议勾\u001b[K\u001b[12C\r\n  Protected）。\u001b[105C\r\n\u001b[120C\r\n  \u001b[1m4.\u001b[22m \u001b[1mSSL\u001b[22m \u001b[1m证书（按需，可空）\u001b[22m\u001b[K\u001b[93C\r\n\u001b[120C\r\n  ┌──────────────┬────────┬─────────────────────────────────────────────────────────────────────┐\u001b[23C\r\n  │    变量名    │  状态  │                                说明                                 │\u001b[23C\r\n  ├──────"]
[1204.2053627967834,"o","────────┼────────┼─────────────────────────────────────────────────────────────────────┤\u001b[23C\r\n  │ \u001b[38;2;177;185;249mUAT_SSL_CERT \u001b[m│ ☐ 留空 │ 本项目应用容器只跑 HTTP（nginx 监听 80），SSL 在 K8s ingress 层终止 │\u001b[K\u001b[23C\r\n  ├──────────────┼────────┼─────────────────────────────────────────────────────────────────────┤\u001b[23C\r\n  │ \u001b[38;2;177;185;249mUAT_SSL_KEY  \u001b[m│ ☐ 留空 │ 同上                                                                │\u001b[K\u001b[23C\r\n  └──────────────┴────────┴──────────────────────────"]
[1204.2054059505463,"o","───────────────────────────────────────────┘\u001b[23C\r\n\u001b[120C\r\n  \u001b[2m▎\u001b[22m \u001b[3m本项目容器不监听\u001b[23m \u001b[3mHTTPS，这两个留空即可。后续要切容器内\u001b[23m \u001b[3mHTTPS\u001b[23m \u001b[3m再配。\u001b[23m\u001b[K\u001b[49C\r\n\u001b[120C\r\n  \u001b[1m5.\u001b[22m \u001b[1m端口变量（本项目不需要）\u001b[22m\u001b[K\u001b[91C\r\n\u001b[120C\r\n  ┌──────────────────┬───────────┬──────────────────────────────────────────────────────────────────┐\u001b[19C\r\n  │      变量名      │   状态    │                               说明                               │\u001b[19C\r\n  ├──────────────────┼───────────┼─────────────────────────────────────"]
