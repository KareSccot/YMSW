[1204.2054996490479,"o","1m6.\u001b[22m \u001b[1m项目特定\u001b[22m \u001b[1mCUSTOM_\u001b[22m \u001b[1m变量\u001b[22m\u001b[K\u001b[94C\r\n\u001b[120C\r\n  \u001b[1m无。\u001b[22m 本项目没有 \u001b[38;2;177;185;249mdocker-compose.yml\u001b[m（ArgoCD 部署用不到），所以不存在 \u001b[38;2;177;185;249mCUSTOM_* \u001b[m占位需要配。构建所需的 \u001b[38;2;177;185;249mVITE_NODE_ENV \u001b[m由  \r\n  \u001b[38;2;177;185;249myarn build:uat \u001b[m脚本自带（\u001b[38;2;177;185;249mVITE_NODE_ENV=uat\u001b[m），无需额外配 GitLab 变量；\u001b[38;2;177;185;249mWEB_PORT\u001b[m/\u001b[38;2;177;185;249mAPI_PROXY \u001b[m仅 dev server 用，\u001b[38;2;177;185;249mvite build \u001b[m\r\n  不读。\u001b[112C\r\n\u001b[120C\r\n  ---\u001b[115C\r\n\u001b[120C\r\n  \u001b[1m写在\u001b[22m \u001b[38;2;177;185;249m\u001b[1m.gitlab-ci.yml\u001b[m\u001b[1m（不放\u001b[22m \u001b[1mUI）的非机密配置\u001b[22m\u001b[K\u001b[76C\r\n\u001b[120C\r\n  这些已写进仓库 \u001b[38;2;177;185;249m.gitlab-ci.yml\u001b[m，跟代码一起进版本控制，\u001b[1m不要\u001b[22m配到 GitLab UI：\u001b[K\u001b[45C\r\n\u001b[120C\r\n  ┌─────────────────────────────────────┬───────"]
